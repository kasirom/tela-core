// ============================================================================
// PUSTAKA STANDAR TELACORE: TELAMASI (ANIMATION & PHYSICS ENGINE FRAMEWORK)
// ============================================================================
// Pustaka resmi Tela Core untuk menangani animasi 2D, skrol latar paralaks dinamis,
// fisika inersia penerbangan halus, sistem partikel asap/api/rudal, dan guncangan layar.
// Nama Pustaka: TELAMASI (Tela Animation & Motion Physics System)
// ============================================================================

impor "../modul/wedus.tela";
impor "../modul/gembus.tela";

gunakan Sistem::*;

// Struct Partikel Animasi (Api, Asap, Jejak Rudal)
struktur TELAMASI_PARTIKEL {
    x: bilangan,
    y: bilangan,
    vx: bilangan,
    vy: bilangan,
    warna: bilangan,
    ukuran: bilangan,
    umur: bilangan
}

// ----------------------------------------------------------------------------
// FUNGSIONALITAS TELAMASI ANIMATION & PHYSICS ENGINE
// ----------------------------------------------------------------------------

// 1. Skrol Paralaks Latar Belakang Bergerak Halus (Background Physics)
fungsi telamasi_skrol_paralaks(hwnd: bilangan, hbitmap_bg: bilangan, offset_y: bilangan, w: bilangan, h: bilangan) {
    jika (hbitmap_bg != 0) maka {
        ubah hdc = GetDC(hwnd);
        jika (hdc != 0) maka {
            ubah mem_dc = CreateCompatibleDC(hdc);
            jika (mem_dc != 0) maka {
                ubah old_bmp = SelectObject(mem_dc, hbitmap_bg);
                
                // Gambar 2 ubin background untuk animasi scrolling tanpa celah
                ubah y1 = offset_y;
                ubah y2 = offset_y - h;
                
                // SRCCOPY = 13369376 (0x00CC0020)
                BitBlt(hdc, 0, y1, w, h, mem_dc, 0, 0, 13369376);
                BitBlt(hdc, 0, y2, w, h, mem_dc, 0, 0, 13369376);
                
                SelectObject(mem_dc, old_bmp);
                DeleteDC(mem_dc);
            }
            ReleaseDC(hwnd, hdc);
        }
    }
}

// 2. Fisika Pergerakan Inersia Halus Pesawat (Smooth Kinematics)
fungsi telamasi_fisika_inersia(pos_sekarang: bilangan, pos_target: bilangan, faktor_kecepatan: bilangan) -> bilangan {
    ubah selisih = pos_target - pos_sekarang;
    jika (selisih != 0) maka {
        ubah langkah = selisih / faktor_kecepatan;
        jika (langkah == 0) maka {
            jika (selisih > 0) maka { langkah = 1; } lainnya { langkah = -1; }
        }
        kembalikan pos_sekarang + langkah;
    }
    kembalikan pos_sekarang;
}

// 3. Efek Partikel Ledakan Bola Api & Jejak Asap Rudal (Particle Engine)
fungsi telamasi_render_efek_partikel(hwnd: bilangan, px: bilangan, py: bilangan, frame_count: bilangan, jenis_partikel: bilangan) {
    ubah hdc = GetDC(hwnd);
    jika (hdc != 0) maka {
        // jenis_partikel: 1: Jejak Asap Thruster, 2: Percikan Api Ledakan
        jika (jenis_partikel == 1) maka {
            // Render 3 lingkaran asap thruster bergerak ke bawah
            ubah val_p = frame_count * 6;
            ubah div_p = val_p / 30;
            ubah offset_p = val_p - (div_p * 30);
            wedus_gambar_lingkaran_hdc(hdc, px, py + 30 + offset_p, 4, 0x00A0A0A0); // Asap Abu-abu
            wedus_gambar_lingkaran_hdc(hdc, px - 3, py + 22 + offset_p, 3, 0x0000A5FF); // Pijar Oranye
            wedus_gambar_lingkaran_hdc(hdc, px + 3, py + 22 + offset_p, 3, 0x0000A5FF);
        }
        jika (jenis_partikel == 2) maka {
            // Render percikan api ledakan radial
            ubah val_r = frame_count * 8;
            ubah div_r = val_r / 40;
            ubah r1 = val_r - (div_r * 40);
            wedus_gambar_lingkaran_hdc(hdc, px - r1, py - r1, 6, 0x0000FFFF); // Kuning
            wedus_gambar_lingkaran_hdc(hdc, px + r1, py - r1, 6, 0x000000FF); // Merah
            wedus_gambar_lingkaran_hdc(hdc, px - r1, py + r1, 6, 0x0000A5FF); // Oranye
            wedus_gambar_lingkaran_hdc(hdc, px + r1, py + r1, 6, 0x00FFFFFF); // Putih
        }
        ReleaseDC(hwnd, hdc);
    }
}

// 4. Efek Guncangan Layar Fisika (Screen Shake Effect)
fungsi telamasi_hitung_getar_layar(frame_count: bilangan, intensitas: bilangan) -> bilangan {
    ubah div_g = frame_count / 2;
    ubah mod_g = frame_count - (div_g * 2);
    jika (mod_g == 0) maka {
        kembalikan intensitas;
    } lainnya {
        kembalikan 0 - intensitas;
    }
}
