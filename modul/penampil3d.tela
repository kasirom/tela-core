// ============================================================================
// MODUL TELACORE: PENAMPIL 3D WIREFRAME (SOFTWARE RENDERER)
// ============================================================================
// Engine grafik 3D Software Renderer tingkat tinggi untuk Tela Core.
// Mendukung transformasi rotasi 3D (Sumbu X, Y, Z), proyeksi perspektif 3D->2D,
// dan rendering Wireframe Mesh (Kubus / Piramida 3D).
// ============================================================================

impor "../modul/grafik.tela";

gunakan Sistem::*;
gunakan Matematika::*;

// ----------------------------------------------------------------------------
// STRUKTUR DATA 3D
// ----------------------------------------------------------------------------

struktur Titik3D {
    x: desimal,
    y: desimal,
    z: desimal
}

struktur Titik2D {
    x: bilangan,
    y: bilangan
}

// ----------------------------------------------------------------------------
// TRANSFORMASI & PROYEKSI 3D
// ----------------------------------------------------------------------------

// Menghitung rotasi 3D untuk 1 titik pada sumbu X, Y, Z
fungsi penampil3d_rotasi(px: desimal, py: desimal, pz: desimal, ax: desimal, ay: desimal, az: desimal, out_x: &desimal, out_y: &desimal, out_z: &desimal) {
    ubah sin_x = sin(ax);
    ubah cos_x = cos(ax);
    ubah sin_y = sin(ay);
    ubah cos_y = cos(ay);
    ubah sin_z = sin(az);
    ubah cos_z = cos(az);

    // Rotasi Sumbu X
    ubah y1 = py * cos_x - pz * sin_x;
    ubah z1 = py * sin_x + pz * cos_x;
    ubah x1 = px;

    // Rotasi Sumbu Y
    ubah x2 = x1 * cos_y + z1 * sin_y;
    ubah z2 = 0.0 - x1 * sin_y + z1 * cos_y;
    ubah y2 = y1;

    // Rotasi Sumbu Z
    ubah x3 = x2 * cos_z - y2 * sin_z;
    ubah y3 = x2 * sin_z + y2 * cos_z;
    ubah z3 = z2;

    *out_x = x3;
    *out_y = y3;
    *out_z = z3;
}

// Memproyeksikan koordinat 3D ke koordinat 2D Layar (Perspektif)
fungsi penampil3d_proyeksi(x3d: desimal, y3d: desimal, z3d: desimal, cx: bilangan, cy: bilangan, fokus: desimal, jarak_z: desimal, out_x2d: &bilangan, out_y2d: &bilangan) {
    ubah z_total = z3d + jarak_z;
    jika (z_total < 0.1) maka {
        z_total = 0.1;
    }
    
    ubah scale = fokus / z_total;
    ubah px = x3d * scale;
    ubah py = y3d * scale;
    
    *out_x2d = cx + (px sebagai bilangan);
    *out_y2d = cy - (py sebagai bilangan);
}

// ----------------------------------------------------------------------------
// HIGH-LEVEL 3D RENDERING
// ----------------------------------------------------------------------------

// Merender Kubus 3D Wireframe lengkap dengan 8 Titik dan 12 Rusuk Garis
fungsi penampil3d_gambar_kubus(hwnd: bilangan, cx: bilangan, cy: bilangan, ax: desimal, ay: desimal, az: desimal, skala: desimal, warna_rgb: bilangan, tebal_garis: bilangan) {
    // 8 Titik Sudut Kubus Unit (-1 sampai +1)
    // 0: (-1,-1,-1), 1: (1,-1,-1), 2: (1,1,-1), 3: (-1,1,-1)
    // 4: (-1,-1, 1), 5: (1,-1, 1), 6: (1,1, 1), 7: (-1,1, 1)

    // Array Koordinat 2D hasil proyeksi untuk 8 titik
    ubah x0 = 0; ubah y0 = 0;
    ubah x1 = 0; ubah y1 = 0;
    ubah x2 = 0; ubah y2 = 0;
    ubah x3 = 0; ubah y3 = 0;
    ubah x4 = 0; ubah y4 = 0;
    ubah x5 = 0; ubah y5 = 0;
    ubah x6 = 0; ubah y6 = 0;
    ubah x7 = 0; ubah y7 = 0;

    ubah rx = 0.0; ubah ry = 0.0; ubah rz = 0.0;
    ubah fokus = 400.0;
    ubah dist = 5.0;

    // Titik 0
    penampil3d_rotasi(0.0 - skala, 0.0 - skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x0, &y0);

    // Titik 1
    penampil3d_rotasi(skala, 0.0 - skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x1, &y1);

    // Titik 2
    penampil3d_rotasi(skala, skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x2, &y2);

    // Titik 3
    penampil3d_rotasi(0.0 - skala, skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x3, &y3);

    // Titik 4
    penampil3d_rotasi(0.0 - skala, 0.0 - skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x4, &y4);

    // Titik 5
    penampil3d_rotasi(skala, 0.0 - skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x5, &y5);

    // Titik 6
    penampil3d_rotasi(skala, skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x6, &y6);

    // Titik 7
    penampil3d_rotasi(0.0 - skala, skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x7, &y7);

    // Render 12 Rusuk Kubus (Gambar Garis 2D)
    // Sisi Depan (z = -1)
    grafik_gambar_garis(hwnd, x0, y0, x1, y1, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x1, y1, x2, y2, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x2, y2, x3, y3, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x3, y3, x0, y0, warna_rgb, tebal_garis);

    // Sisi Belakang (z = +1)
    grafik_gambar_garis(hwnd, x4, y4, x5, y5, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x5, y5, x6, y6, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x6, y6, x7, y7, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x7, y7, x4, y4, warna_rgb, tebal_garis);

    // Garis Penghubung Depan-Belakang
    grafik_gambar_garis(hwnd, x0, y0, x4, y4, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x1, y1, x5, y5, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x2, y2, x6, y6, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x3, y3, x7, y7, warna_rgb, tebal_garis);
}

// Merender Piramida 3D Wireframe
fungsi penampil3d_gambar_piramida(hwnd: bilangan, cx: bilangan, cy: bilangan, ax: desimal, ay: desimal, az: desimal, skala: desimal, warna_rgb: bilangan, tebal_garis: bilangan) {
    // 5 Titik: 4 Titik Alas, 1 Puncak
    ubah x0 = 0; ubah y0 = 0;
    ubah x1 = 0; ubah y1 = 0;
    ubah x2 = 0; ubah y2 = 0;
    ubah x3 = 0; ubah y3 = 0;
    ubah xp = 0; ubah yp = 0; // Puncak

    ubah rx = 0.0; ubah ry = 0.0; ubah rz = 0.0;
    ubah fokus = 400.0;
    ubah dist = 5.0;

    // Alas 0: (-1, -1, -1)
    penampil3d_rotasi(0.0 - skala, 0.0 - skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x0, &y0);

    // Alas 1: (1, -1, -1)
    penampil3d_rotasi(skala, 0.0 - skala, 0.0 - skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x1, &y1);

    // Alas 2: (1, -1, 1)
    penampil3d_rotasi(skala, 0.0 - skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x2, &y2);

    // Alas 3: (-1, -1, 1)
    penampil3d_rotasi(0.0 - skala, 0.0 - skala, skala, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &x3, &y3);

    // Puncak: (0, 1.2, 0)
    penampil3d_rotasi(0.0, skala * 1.2, 0.0, ax, ay, az, &rx, &ry, &rz);
    penampil3d_proyeksi(rx, ry, rz, cx, cy, fokus, dist, &xp, &yp);

    // Gambar Garis Alas
    grafik_gambar_garis(hwnd, x0, y0, x1, y1, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x1, y1, x2, y2, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x2, y2, x3, y3, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x3, y3, x0, y0, warna_rgb, tebal_garis);

    // Gambar Garis Menuju Puncak
    grafik_gambar_garis(hwnd, x0, y0, xp, yp, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x1, y1, xp, yp, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x2, y2, xp, yp, warna_rgb, tebal_garis);
    grafik_gambar_garis(hwnd, x3, y3, xp, yp, warna_rgb, tebal_garis);
}
