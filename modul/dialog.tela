luar fungsi vis_update(is_playing: bilangan);
luar fungsi vis_dapat_bar(index: bilangan) -> bilangan;
luar fungsi vis_dapat_peak(index: bilangan) -> bilangan;

// C-Backend GDI Flush
luar fungsi gdi_paksa_render();

// C-Backend Audio Controls
