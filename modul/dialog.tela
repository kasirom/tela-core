luar fungsi wedus_mulai_render(hwnd: bilangan, w: bilangan, h: bilangan);
luar fungsi wedus_selesai_render(hwnd: bilangan, w: bilangan, h: bilangan);

// C-Backend Fixer
luar fungsi dialog_set_background_hitam(hwnd: bilangan);
