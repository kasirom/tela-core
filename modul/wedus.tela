// ============================================================================
// PUSTAKA STANDAR TELACORE: WEDUS (GUI DESKTOP FRAMEWORK - SETARA TKINTER)
// ============================================================================
// Pustaka resmi Tela Core untuk merancang antarmuka pengguna grafis (GUI)
// desktop interaktif dengan mudah di berbagai sistem operasi.
// Nama Pustaka: WEDUS (Window & Element Desktop User System)
// ============================================================================

gunakan Sistem::*;

// Struct untuk Windows Event Message
struktur WEDUS_PESAN {
    hwnd: bilangan,
    message: bilangan,
    wParam: bilangan,
    lParam: bilangan,
    time: bilangan,
    pt_x: bilangan,
    pt_y: bilangan
}

// Deklarasi FFI C Native Win32 GDI & User32
asing fungsi CreateWindowExA(exStyle: bilangan, className: teks, winName: teks, style: bilangan, x: bilangan, y: bilangan, w: bilangan, h: bilangan, parent: bilangan, menu: bilangan, inst: bilangan, param: bilangan) -> bilangan;
asing fungsi GetDC(hwnd: bilangan) -> bilangan;
asing fungsi ReleaseDC(hwnd: bilangan, hdc: bilangan) -> bilangan;
asing fungsi CreateSolidBrush(color: bilangan) -> bilangan;
asing fungsi CreatePen(style: bilangan, width: bilangan, color: bilangan) -> bilangan;
asing fungsi SelectObject(hdc: bilangan, obj: bilangan) -> bilangan;
asing fungsi DeleteObject(obj: bilangan) -> bilangan;
asing fungsi Rectangle(hdc: bilangan, left: bilangan, top: bilangan, right: bilangan, bottom: bilangan) -> bilangan;
asing fungsi Ellipse(hdc: bilangan, left: bilangan, top: bilangan, right: bilangan, bottom: bilangan) -> bilangan;
asing fungsi MoveToEx(hdc: bilangan, x: bilangan, y: bilangan, pt: bilangan) -> bilangan;
asing fungsi LineTo(hdc: bilangan, x: bilangan, y: bilangan) -> bilangan;
asing fungsi SetPixel(hdc: bilangan, x: bilangan, y: bilangan, color: bilangan) -> bilangan;
asing fungsi TextOutA(hdc: bilangan, x: bilangan, y: bilangan, text_val: teks, len_val: bilangan) -> bilangan;
asing fungsi ShowWindow(hwnd: bilangan, cmd: bilangan) -> bilangan;
asing fungsi PeekMessageA(lpMsg: &WEDUS_PESAN, hWnd: bilangan, wMsgFilterMin: bilangan, wMsgFilterMax: bilangan, wRemoveMsg: bilangan) -> bilangan;
asing fungsi TranslateMessage(lpMsg: &WEDUS_PESAN) -> bilangan;
asing fungsi DispatchMessageA(lpMsg: &WEDUS_PESAN) -> bilangan;
asing fungsi DefWindowProcA(hWnd: bilangan, Msg: bilangan, wParam: bilangan, lParam: bilangan) -> bilangan;

// ----------------------------------------------------------------------------
// FUNGSIONALITAS WEDUS GUI (SETARA TKINTER)
// ----------------------------------------------------------------------------

// 1. Membuat Jendela Utama (Setara tk.Tk())
fungsi wedus_buat_jendela(judul: teks, lebar: bilangan, tinggi: bilangan) -> bilangan {
    ubah style = 0x10000000; // WS_VISIBLE
    ubah style_window = style + 0x00CF0000; // WS_OVERLAPPEDWINDOW
    ubah hwnd = CreateWindowExA(0, "STATIC", judul, style_window, 80, 80, lebar, tinggi, 0, 0, 0, 0);
    jika (hwnd != 0) maka {
        ShowWindow(hwnd, 5);
        Sistem::cetak_teks("[Pustaka WEDUS] Jendela GUI berhasil dibuat.");
    } lainnya {
        Sistem::cetak_teks("[Pustaka WEDUS] Gagal membuat jendela GUI.");
    }
    kembalikan hwnd;
}

// 2. Membuat Label Teks (Setara tk.Label())
fungsi wedus_buat_label(hwnd: bilangan, x: bilangan, y: bilangan, isi: teks) {
    ubah hdc = GetDC(hwnd);
    jika (hdc != 0) maka {
        ubah panjang = strlen(isi);
        TextOutA(hdc, x, y, isi, panjang);
        ReleaseDC(hwnd, hdc);
    }
}

// 3. Membuat Tombol Interaktif (Setara tk.Button())
fungsi wedus_buat_tombol(hwnd: bilangan, x: bilangan, y: bilangan, w: bilangan, h: bilangan, teks_tombol: teks) -> bilangan {
    ubah style = 0x50000000; // WS_VISIBLE | WS_CHILD
    ubah btn_hwnd = CreateWindowExA(0, "BUTTON", teks_tombol, style, x, y, w, h, hwnd, 0, 0, 0);
    kembalikan btn_hwnd;
}

// 4. Element Gambar Bentuk 2D (Kotak, Lingkaran, Garis)
fungsi wedus_gambar_kotak(hwnd: bilangan, x1: bilangan, y1: bilangan, x2: bilangan, y2: bilangan, warna_rgb: bilangan) {
    ubah hdc = GetDC(hwnd);
    jika (hdc != 0) maka {
        ubah brush = CreateSolidBrush(warna_rgb);
        ubah pen = CreatePen(0, 1, warna_rgb);
        
        ubah old_brush = SelectObject(hdc, brush);
        ubah old_pen = SelectObject(hdc, pen);
        
        Rectangle(hdc, x1, y1, x2, y2);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        DeleteObject(brush);
        DeleteObject(pen);
        
        ReleaseDC(hwnd, hdc);
    }
}

fungsi wedus_gambar_lingkaran_hdc(hdc: bilangan, cx: bilangan, cy: bilangan, radius: bilangan, warna_rgb: bilangan) {
    jika (hdc != 0) maka {
        ubah brush = CreateSolidBrush(warna_rgb);
        ubah pen = CreatePen(0, 1, warna_rgb);
        
        ubah old_brush = SelectObject(hdc, brush);
        ubah old_pen = SelectObject(hdc, pen);
        
        Ellipse(hdc, cx - radius, cy - radius, cx + radius, cy + radius);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        DeleteObject(brush);
        DeleteObject(pen);
    }
}

fungsi wedus_gambar_lingkaran(hwnd: bilangan, cx: bilangan, cy: bilangan, radius: bilangan, warna_rgb: bilangan) {
    ubah hdc = GetDC(hwnd);
    jika (hdc != 0) maka {
        wedus_gambar_lingkaran_hdc(hdc, cx, cy, radius, warna_rgb);
        ReleaseDC(hwnd, hdc);
    }
}

fungsi wedus_gambar_garis(hwnd: bilangan, x1: bilangan, y1: bilangan, x2: bilangan, y2: bilangan, warna_rgb: bilangan, tebal: bilangan) {
    ubah hdc = GetDC(hwnd);
    jika (hdc != 0) maka {
        ubah pen = CreatePen(0, tebal, warna_rgb);
        ubah old_pen = SelectObject(hdc, pen);
        
        MoveToEx(hdc, x1, y1, 0);
        LineTo(hdc, x2, y2);
        
        SelectObject(hdc, old_pen);
        DeleteObject(pen);
        ReleaseDC(hwnd, hdc);
    }
}

fungsi wedus_tulis_teks(hwnd: bilangan, x: bilangan, y: bilangan, isi: teks) {
    wedus_buat_label(hwnd, x, y, isi);
}

fungsi wedus_bersihkan_layar(hwnd: bilangan, lebar: bilangan, tinggi: bilangan, warna_rgb: bilangan) {
    wedus_gambar_kotak(hwnd, 0, 0, lebar, tinggi, warna_rgb);
}

// 5. Event Loop Processor (Setara tk.mainloop())
fungsi wedus_proses_kejadian() -> bilangan {
    ubah msg = WEDUS_PESAN { hwnd: 0, message: 0, wParam: 0, lParam: 0, time: 0, pt_x: 0, pt_y: 0 };
    ubah ada_pesan = PeekMessageA(&msg, 0, 0, 0, 1); // PM_REMOVE = 1
    jika (ada_pesan > 0) maka {
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
        DefWindowProcA(msg.hwnd, msg.message, msg.wParam, msg.lParam);
        jika (msg.message == 18 || msg.message == 16 || msg.message == 2) maka { // WM_QUIT (18), WM_CLOSE (16), WM_DESTROY (2)
            kembalikan 0;
        }
    }
    kembalikan 1;
}
