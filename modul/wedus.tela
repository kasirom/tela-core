// ============================================================================
// PUSTAKA STANDAR TELACORE: WEDUS (GUI DESKTOP FRAMEWORK - SETARA TKINTER)
// ============================================================================
// Pustaka resmi Tela Core untuk merancang antarmuka pengguna grafis (GUI)
// desktop interaktif dengan mudah di berbagai sistem operasi.
// Nama Pustaka: WEDUS (Window & Element Desktop User System)
// ============================================================================

gunakan Sistem::*;

// Struct untuk Windows Event Message
struktur WEDUS_PESAN {
    hwnd: bilangan,
    message: bilangan,
    wParam: bilangan,
    lParam: bilangan,
    time: bilangan,
    pt_x: bilangan,
    pt_y: bilangan
}

// Deklarasi FFI C Native Win32 GDI & User32
luar fungsi CreateWindowExA(exStyle: bilangan, className: teks, winName: teks, style: bilangan, x: bilangan, y: bilangan, w: bilangan, h: bilangan, parent: bilangan, menu: bilangan, inst: bilangan, param: bilangan) -> bilangan;
luar fungsi GetDC(hwnd: bilangan) -> bilangan;
luar fungsi ReleaseDC(hwnd: bilangan, hdc: bilangan) -> bilangan;
luar fungsi CreateSolidBrush(color: bilangan) -> bilangan;
luar fungsi CreatePen(style: bilangan, width: bilangan, color: bilangan) -> bilangan;
luar fungsi SelectObject(hdc: bilangan, obj: bilangan) -> bilangan;
luar fungsi DeleteObject(obj: bilangan) -> bilangan;
luar fungsi Rectangle(hdc: bilangan, left: bilangan, top: bilangan, right: bilangan, bottom: bilangan) -> bilangan;
luar fungsi Ellipse(hdc: bilangan, left: bilangan, top: bilangan, right: bilangan, bottom: bilangan) -> bilangan;
luar fungsi MoveToEx(hdc: bilangan, x: bilangan, y: bilangan, pt: bilangan) -> bilangan;
luar fungsi LineTo(hdc: bilangan, x: bilangan, y: bilangan) -> bilangan;
luar fungsi SetPixel(hdc: bilangan, x: bilangan, y: bilangan, color: bilangan) -> bilangan;
luar fungsi TextOutA(hdc: bilangan, x: bilangan, y: bilangan, text_val: teks, len_val: bilangan) -> bilangan;
luar fungsi SetBkMode(hdc: bilangan, mode: bilangan) -> bilangan;
luar fungsi SetTextColor(hdc: bilangan, color: bilangan) -> bilangan;
luar fungsi ShowWindow(hwnd: bilangan, cmd: bilangan) -> bilangan;
luar fungsi GetSystemMetrics(nIndex: bilangan) -> bilangan;
luar fungsi PeekMessageA(lpMsg: &WEDUS_PESAN, hWnd: bilangan, wMsgFilterMin: bilangan, wMsgFilterMax: bilangan, wRemoveMsg: bilangan) -> bilangan;
luar fungsi TranslateMessage(lpMsg: &WEDUS_PESAN) -> bilangan;
luar fungsi DispatchMessageA(lpMsg: &WEDUS_PESAN) -> bilangan;
luar fungsi DefWindowProcA(hWnd: bilangan, Msg: bilangan, wParam: bilangan, lParam: bilangan) -> bilangan;
luar fungsi BitBlt(hdcDest: bilangan, nXDest: bilangan, nYDest: bilangan, nWidth: bilangan, nHeight: bilangan, hdcSrc: bilangan, nXSrc: bilangan, nYSrc: bilangan, dwRop: bilangan) -> bilangan;

// Buffer FFI dari dialog.c
luar fungsi get_current_hdc(hwnd: bilangan) -> bilangan;
luar fungsi release_current_hdc(hwnd: bilangan, hdc: bilangan);
luar fungsi wedus_apply_font(hdc: bilangan);

// ----------------------------------------------------------------------------
// FUNGSIONALITAS WEDUS GUI (SETARA TKINTER)
// ----------------------------------------------------------------------------

impor "../modul/dialog.tela";

// 1. Membuat Jendela Utama (Setara tk.Tk())
fungsi wedus_buat_jendela(judul: teks, lebar: bilangan, tinggi: bilangan) -> bilangan {
    ubah hwnd = dialog_buat_jendela_native(judul, lebar, tinggi);
    jika (hwnd != 0) maka {
        Sistem::cetak_teks("[Pustaka WEDUS] Jendela GUI Native berhasil dibuat.");
    } lainnya {
        Sistem::cetak_teks("[Pustaka WEDUS] Gagal membuat jendela GUI.");
    }
    kembalikan hwnd;
}

// 2. Membuat Label Teks (Setara tk.Label())
fungsi wedus_buat_label(hwnd: bilangan, x: bilangan, y: bilangan, isi: teks, warna_teks: bilangan, transparan: bilangan) {
        ubah hdc = get_current_hdc(hwnd);
        jika (hdc != 0) maka {
        SetTextColor(hdc, warna_teks);
        wedus_apply_font(hdc);
        jika (transparan == 1) maka {
            SetBkMode(hdc, 1); // 1 = TRANSPARENT
        } lainnya {
            SetBkMode(hdc, 2); // 2 = OPAQUE
        }
        
        ubah panjang = strlen(isi);
        TextOutA(hdc, x, y, isi, panjang);
        release_current_hdc(hwnd, hdc);
    }
}

// 3. Membuat Tombol Interaktif (Setara tk.Button())
fungsi wedus_buat_tombol(hwnd: bilangan, x: bilangan, y: bilangan, w: bilangan, h: bilangan, teks_tombol: teks) -> bilangan {
    ubah style = 0x50000000; // WS_VISIBLE | WS_CHILD
    ubah btn_hwnd = CreateWindowExA(0, "BUTTON", teks_tombol, style, x, y, w, h, hwnd, 0, 0, 0);
    kembalikan btn_hwnd;
}

// 4. Element Gambar Bentuk 2D (Kotak, Lingkaran, Garis)
fungsi wedus_gambar_kotak(hwnd: bilangan, x1: bilangan, y1: bilangan, x2: bilangan, y2: bilangan, warna_rgb: bilangan) {
        ubah hdc = get_current_hdc(hwnd);
        jika (hdc != 0) maka {
        ubah brush = CreateSolidBrush(warna_rgb);
        ubah pen = CreatePen(0, 1, warna_rgb);
        
        ubah old_brush = SelectObject(hdc, brush);
        ubah old_pen = SelectObject(hdc, pen);
        
        Rectangle(hdc, x1, y1, x2, y2);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        DeleteObject(brush);
        DeleteObject(pen);
        
        release_current_hdc(hwnd, hdc);
    }
}

fungsi wedus_gambar_lingkaran_hdc(hdc: bilangan, cx: bilangan, cy: bilangan, radius: bilangan, warna_rgb: bilangan) {
    jika (hdc != 0) maka {
        ubah brush = CreateSolidBrush(warna_rgb);
        ubah pen = CreatePen(0, 1, warna_rgb);
        
        ubah old_brush = SelectObject(hdc, brush);
        ubah old_pen = SelectObject(hdc, pen);
        
        Ellipse(hdc, cx - radius, cy - radius, cx + radius, cy + radius);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        DeleteObject(brush);
        DeleteObject(pen);
    }
}

fungsi wedus_gambar_lingkaran(hwnd: bilangan, cx: bilangan, cy: bilangan, radius: bilangan, warna_rgb: bilangan) {
        ubah hdc = get_current_hdc(hwnd);
        jika (hdc != 0) maka {
        wedus_gambar_lingkaran_hdc(hdc, cx, cy, radius, warna_rgb);
        release_current_hdc(hwnd, hdc);
    }
}

fungsi wedus_gambar_garis(hwnd: bilangan, x1: bilangan, y1: bilangan, x2: bilangan, y2: bilangan, warna_rgb: bilangan, tebal: bilangan) {
        ubah hdc = get_current_hdc(hwnd);
        jika (hdc != 0) maka {
        ubah pen = CreatePen(0, tebal, warna_rgb);
        ubah old_pen = SelectObject(hdc, pen);
        
        MoveToEx(hdc, x1, y1, 0);
        LineTo(hdc, x2, y2);
        
        SelectObject(hdc, old_pen);
        DeleteObject(pen);
        release_current_hdc(hwnd, hdc);
    }
}

fungsi wedus_gambar_bingkai(hwnd: bilangan, x1: bilangan, y1: bilangan, x2: bilangan, y2: bilangan, warna_rgb: bilangan, tebal: bilangan) {
    wedus_gambar_garis(hwnd, x1, y1, x2, y1, warna_rgb, tebal);
    wedus_gambar_garis(hwnd, x1, y2, x2, y2, warna_rgb, tebal);
    wedus_gambar_garis(hwnd, x1, y1, x1, y2, warna_rgb, tebal);
    wedus_gambar_garis(hwnd, x2, y1, x2, y2, warna_rgb, tebal);
}

fungsi wedus_tulis_teks(hwnd: bilangan, x: bilangan, y: bilangan, isi: teks) {
    // Default: Hitam, Transparan
    wedus_buat_label(hwnd, x, y, isi, 0x000000, 1);
}

fungsi wedus_tulis_teks_warna(hwnd: bilangan, x: bilangan, y: bilangan, isi: teks, warna_teks: bilangan) {
    wedus_buat_label(hwnd, x, y, isi, warna_teks, 1);
}

fungsi wedus_bersihkan_layar(hwnd: bilangan, lebar: bilangan, tinggi: bilangan, warna_rgb: bilangan) {
    wedus_gambar_kotak(hwnd, 0, 0, lebar, tinggi, warna_rgb);
}

// 5. Event Loop Processor (Setara tk.mainloop())
fungsi wedus_proses_kejadian() -> bilangan {
    kembalikan proses_kejadian_c();
}

luar fungsi wedus_gambar_bitmap(hwnd: bilangan, x: bilangan, y: bilangan, w: bilangan, h: bilangan, path: teks);
