// ============================================================================
// MODUL TELACORE: WINAMP GUI MP3 PLAYER
// ============================================================================
// Modul pendukung untuk membuat aplikasi musik player GUI yang menyerupai
// antarmuka Winamp modern sederhana dengan tombol play, stop, pause,
// open file, open folder, close, open playlist, dan create playlist.
// Dibangun di atas pustaka WEDUS dan SWORO yang sudah ada.
// ============================================================================

impor "../modul/wedus.tela";
impor "../modul/sworo.tela";

gunakan Sistem::*;

struktur WINAMP_STATUS {
    judul_lagu: teks,
    status_putar: teks,
    volume: bilangan,
    posisi: bilangan,
    sedang_berjalan: bilangan
}

struktur WINAMP_PLAYLIST {
    nama: teks,
    item_aktif: bilangan,
    jumlah_lagu: bilangan
}

fungsi winamp_buat_jendela(judul: teks, lebar: bilangan, tinggi: bilangan) -> bilangan {
    ubah hwnd = wedus_buat_jendela(judul, lebar, tinggi);
    kembalikan hwnd;
}

fungsi winamp_tampilkan_ui(hwnd: bilangan, judul_lagu: teks, status_putar: teks, volume: bilangan, posisi: bilangan, sedang_berjalan: bilangan) {
    wedus_bersihkan_layar(hwnd, 860, 540, 0x1F1F1F);

    wedus_gambar_kotak(hwnd, 20, 20, 840, 80, 0x2B2B2B);
    wedus_gambar_garis(hwnd, 20, 80, 840, 80, 0xFFAA00, 2);
    wedus_tulis_teks(hwnd, 30, 34, "File  View  Playback  Help");
    wedus_tulis_teks(hwnd, 30, 56, "TELA WINAMP PLAYER");

    wedus_gambar_kotak(hwnd, 20, 100, 280, 500, 0x2A2A2A);
    wedus_gambar_garis(hwnd, 20, 100, 280, 100, 0xFFAA00, 1);
    wedus_tulis_teks(hwnd, 35, 115, "Playlist");
    wedus_tulis_teks(hwnd, 35, 140, "[x] Yakin Bisa.mp3");
    wedus_tulis_teks(hwnd, 35, 165, "[ ] Ambang.mp3");
    wedus_tulis_teks(hwnd, 35, 190, "[ ] Senja.mp3");
    wedus_tulis_teks(hwnd, 35, 215, "[ ] Outro.mp3");
    wedus_tulis_teks(hwnd, 35, 240, "[ ] Laskar Pelangi.mp3");

    wedus_gambar_kotak(hwnd, 300, 100, 840, 500, 0x1A1A1A);
    wedus_gambar_garis(hwnd, 300, 100, 840, 100, 0xFFAA00, 1);
    wedus_tulis_teks(hwnd, 320, 115, "Now Playing");
    wedus_tulis_teks(hwnd, 320, 145, judul_lagu);
    wedus_tulis_teks(hwnd, 320, 170, "Status:");
    wedus_tulis_teks(hwnd, 390, 170, status_putar);

    jika (status_putar == "Playing") maka {
        wedus_gambar_kotak(hwnd, 320, 195, 430, 245, 0xFFAA00);
        wedus_tulis_teks(hwnd, 340, 215, "PLAYING");
    } lainnya {
        jika (status_putar == "Paused") maka {
            wedus_gambar_kotak(hwnd, 320, 195, 430, 245, 0x555555);
            wedus_tulis_teks(hwnd, 340, 215, "PAUSED");
        } lainnya {
            wedus_gambar_kotak(hwnd, 320, 195, 430, 245, 0x2D2D2D);
            wedus_tulis_teks(hwnd, 340, 215, "STOPPED");
        }
    }

    wedus_tulis_teks(hwnd, 320, 265, "Volume:");
    wedus_tulis_teks(hwnd, 390, 265, "80%");
    wedus_tulis_teks(hwnd, 320, 290, "Position:");
    wedus_tulis_teks(hwnd, 390, 290, "00:42");
    wedus_tulis_teks(hwnd, 320, 315, "Folder:");
    wedus_tulis_teks(hwnd, 390, 315, "aset/sfx");
    wedus_tulis_teks(hwnd, 320, 340, "Kontrol:");
    wedus_tulis_teks(hwnd, 320, 365, "Play   Pause   Stop");

    wedus_gambar_kotak(hwnd, 20, 500, 840, 530, 0x1F1F1F);
    wedus_gambar_garis(hwnd, 20, 500, 840, 500, 0xFFAA00, 1);
    wedus_tulis_teks(hwnd, 30, 510, "Status bar: siap diputar");
}

fungsi winamp_tampilkan_status(hwnd: bilangan, judul_lagu: teks, status_putar: teks, volume: bilangan, posisi: bilangan, sedang_berjalan: bilangan) {
    winamp_tampilkan_ui(hwnd, judul_lagu, status_putar, volume, posisi, sedang_berjalan);
}

fungsi winamp_buat_playlist(nama_playlist: teks) -> WINAMP_PLAYLIST {
    ubah playlist = WINAMP_PLAYLIST {
        nama: nama_playlist,
        item_aktif: 0,
        jumlah_lagu: 3
    };
    kembalikan playlist;
}

fungsi winamp_putar_lagu(hwnd: bilangan, path_berkas: teks) -> bilangan {
    ubah hasil = sworo_putar_mp3(path_berkas);
    jika (hasil != 0) maka {
        winamp_tampilkan_status(hwnd, path_berkas, "Playing", 80, 0, 1);
        kembalikan 1;
    }
    kembalikan 0;
}

fungsi winamp_jeda_lagu(hwnd: bilangan) {
    sworo_henti_mp3();
    winamp_tampilkan_status(hwnd, "Lagu dijeda", "Paused", 80, 0, 0);
}

fungsi winamp_hentikan_lagu(hwnd: bilangan) {
    sworo_henti_mp3();
    winamp_tampilkan_status(hwnd, "Tidak ada lagu", "Stopped", 80, 0, 0);
}

fungsi winamp_buka_playlist(hwnd: bilangan, playlist: WINAMP_PLAYLIST) {
    wedus_tulis_teks(hwnd, 420, 150, "Playlist Aktif:");
    wedus_tulis_teks(hwnd, 420, 175, playlist.nama);
    wedus_tulis_teks(hwnd, 420, 200, "Item aktif:");
    wedus_tulis_teks(hwnd, 420, 225, "1");
    wedus_tulis_teks(hwnd, 420, 250, "Mode:");
    wedus_tulis_teks(hwnd, 420, 275, "Normal");
    Sistem::cetak_teks("[Winamp] Playlist dibuka.");
}

fungsi winamp_buka_berkas_lagu(hwnd: bilangan, path_berkas: teks) -> bilangan {
    ubah hasil = winamp_putar_lagu(hwnd, path_berkas);
    jika (hasil != 0) maka {
        wedus_tulis_teks(hwnd, 420, 310, "Berkas:");
        wedus_tulis_teks(hwnd, 420, 335, path_berkas);
        wedus_tulis_teks(hwnd, 420, 360, "Status:");
        wedus_tulis_teks(hwnd, 420, 385, "Playing");
        kembalikan 1;
    }
    kembalikan 0;
}

fungsi winamp_buka_folder(hwnd: bilangan, folder: teks) {
    wedus_tulis_teks(hwnd, 420, 410, "Folder:");
    wedus_tulis_teks(hwnd, 420, 435, folder);
    Sistem::cetak_teks("[Winamp] Folder dipilih.");
}

fungsi winamp_tutup_player(hwnd: bilangan) {
    winamp_hentikan_lagu(hwnd);
    wedus_tulis_teks(hwnd, 420, 460, "Status:");
    wedus_tulis_teks(hwnd, 420, 485, "Closed");
}

fungsi winamp_status() -> WINAMP_STATUS {
    ubah st = WINAMP_STATUS {
        judul_lagu: "Yakin Bisa.mp3",
        status_putar: "Stop",
        volume: 80,
        posisi: 0,
        sedang_berjalan: 0
    };
    kembalikan st;
}

fungsi winamp_buat_status(judul_lagu: teks, status_putar: teks, volume: bilangan, posisi: bilangan, sedang_berjalan: bilangan) -> WINAMP_STATUS {
    ubah st = WINAMP_STATUS {
        judul_lagu: judul_lagu,
        status_putar: status_putar,
        volume: volume,
        posisi: posisi,
        sedang_berjalan: sedang_berjalan
    };
    kembalikan st;
}
