impor "src/tui.tela";

fungsi utama() -> bilangan {
    ubah pesan: teks = "Menguji Tela Fase 3...\n";
    cetak_teks(pesan);

    ubah i: bilangan = 0;

    putar {
        i = i + 1;
        
        jika (i == 3) maka {
            cetak_teks("Mencapai 3, Lanjut!\n");
            lanjut;
        } lainnya jika (i == 5) maka {
            cetak_teks("Mencapai 5, Henti!\n");
            henti;
        } lainnya {
            cetak_desimal(i);
            cetak_teks("\n");
        }
    }

    kembalikan 0;
}
