fungsi utama() {
    ubah arr = [10, 20, 30];
    Sistem::cetak_teks("Sebelum ubah:");
    Sistem::cetak_bilangan(arr[0]);
    Sistem::cetak_bilangan(arr[1]);
    Sistem::cetak_bilangan(arr[2]);
    
    arr[0] = 99;
    arr[1] = 88;
    arr[2] = 77;
    
    Sistem::cetak_teks("Setelah ubah:");
    Sistem::cetak_bilangan(arr[0]);
    Sistem::cetak_bilangan(arr[1]);
    Sistem::cetak_bilangan(arr[2]);
}
