tugas fungsi tambah_satu(angka: bilangan) -> bilangan {
    kembalikan angka + 1;
}

tugas fungsi kali_dua(angka: bilangan) -> bilangan {
    kembalikan angka * 2;
}

tugas fungsi utama() {
    Sistem::cetak_teks("Memulai tugas asinkron...");
    
    ubah t1 = tambah_satu(100);
    ubah t2 = kali_dua(50);
    
    ubah hasil1 = tunggu t1;
    ubah hasil2 = tunggu t2;
    
    Sistem::cetak_teks("Hasil 1 (100 + 1):");
    Sistem::cetak_bilangan(hasil1);
    
    Sistem::cetak_teks("Hasil 2 (50 * 2):");
    Sistem::cetak_bilangan(hasil2);
}
