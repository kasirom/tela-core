gunakan Sistem::*;

fungsi tui_bersihkan() {
    cetak_teks("\e[2J\e[H");
}

fungsi tui_posisi(baris: bilangan, kolom: bilangan) {
    cetak_teks("\e[");
    cetak_bilangan(baris);
    cetak_teks(";");
    cetak_bilangan(kolom);
    cetak_teks("H");
}

fungsi tui_warna_teks(kode: bilangan) {
    cetak_teks("\e[");
    cetak_bilangan(kode);
    cetak_teks("m");
}

fungsi tui_warna_latar(kode: bilangan) {
    cetak_teks("\e[");
    cetak_bilangan(kode);
    cetak_teks("m");
}

fungsi tui_reset() {
    cetak_teks("\e[0m");
}
