impor "src/tui.tela";

gunakan Sistem::*;
gunakan Waktu::*;

asing fungsi sscanf(str_val: teks, fmt_val: teks, y_ptr: &bilangan, m_ptr: &bilangan, d_ptr: &bilangan, hr_ptr: &bilangan, min_ptr: &bilangan, sec_ptr: &bilangan) -> bilangan;
asing fungsi MessageBoxA(hwnd_val: bilangan, pesan_val: teks, judul_val: teks, tipe_val: bilangan) -> bilangan;
asing fungsi PlaySoundA(soundName: teks, hmod_val: bilangan, flags_val: bilangan) -> bilangan;
asing fungsi Sleep(dwMilliseconds: bilangan) -> kosong;

fungsi main_clock_loop() {
    ubah alarm_jam: bilangan = -1;
    ubah alarm_menit: bilangan = -1;
    ubah pengingat: teks = "Waktunya bangun!";
    ubah alarm_aktif: logika = salah;
    
    ubah fmt_parse: teks = "%d-%d-%d %d:%d:%d";
    
    tui_bersihkan();
    
    ubah loop_run = 1;
    selama (loop_run == 1) {
        ubah waktu_str = waktu_sekarang();
        
        ubah y: bilangan = 0;
        ubah m: bilangan = 0;
        ubah d: bilangan = 0;
        ubah hr: bilangan = 0;
        ubah min: bilangan = 0;
        ubah sec: bilangan = 0;
        
        sscanf(waktu_str, fmt_parse, &y, &m, &d, &hr, &min, &sec);
        
        tui_posisi(2, 5);
        tui_warna_teks(36);
        Sistem::cetak_teks("=========================================");
        tui_posisi(3, 5);
        Sistem::cetak_teks("      🕰️ JAM DIGITAL TELA NUSANTARA 🕰️      ");
        tui_posisi(4, 5);
        Sistem::cetak_teks("=========================================");
        
        tui_posisi(6, 10);
        tui_warna_teks(32);
        Sistem::cetak_teks("Tanggal : ");
        Sistem::cetak_bilangan(d);
        Sistem::cetak_teks("/");
        Sistem::cetak_bilangan(m);
        Sistem::cetak_teks("/");
        Sistem::cetak_bilangan(y);
        
        tui_posisi(7, 10);
        tui_warna_teks(33);
        Sistem::cetak_teks("Waktu   : ");
        Sistem::cetak_bilangan(hr);
        Sistem::cetak_teks(":");
        Sistem::cetak_bilangan(min);
        Sistem::cetak_teks(":");
        Sistem::cetak_bilangan(sec);
        Sistem::cetak_teks("   ");
        
        tui_posisi(9, 5);
        tui_warna_teks(35);
        Sistem::cetak_teks("-----------------------------------------");
        tui_posisi(10, 5);
        Sistem::cetak_teks("Status Alarm: ");
        jika (alarm_aktif) maka {
            tui_warna_teks(32);
            Sistem::cetak_teks("AKTIF PADA ");
            Sistem::cetak_bilangan(alarm_jam);
            Sistem::cetak_teks(":");
            Sistem::cetak_bilangan(alarm_menit);
        } lainnya {
            tui_warna_teks(31);
            Sistem::cetak_teks("NON-AKTIF");
        }
        
        tui_posisi(11, 5);
        tui_warna_teks(35);
        Sistem::cetak_teks("Pengingat   : ");
        Sistem::cetak_teks(pengingat);
        tui_posisi(12, 5);
        Sistem::cetak_teks("-----------------------------------------");
        
        tui_posisi(14, 5);
        tui_warna_teks(37);
        Sistem::cetak_teks("Info: [Simulasi] Detik 15 set alarm menit+1. Detik 35 uji suara.");
        
        // Pemicu Alarm
        jika (alarm_aktif) maka {
            jika (hr == alarm_jam) maka {
                jika (min == alarm_menit) maka {
                    alarm_aktif = salah;
                    
                    // Mainkan suara Windows System Asterisk secara asinkron
                    PlaySoundA("SystemAsterisk", 0, 1);
                    PlaySoundA("SystemHand", 0, 1);
                    
                    tui_posisi(16, 5);
                    tui_warna_teks(31);
                    Sistem::cetak_teks("🚨 ALARM DIPICU! TAMPILKAN POPUP DI LAYAR...");
                    
                    // Jendela Grafik Native Windows
                    MessageBoxA(0, pengingat, "ALARM TELA NUSANTARA", 48);
                    
                    tui_posisi(16, 5);
                    Sistem::cetak_teks("                                             ");
                }
            }
        }
        
        // Delay 1 detik yang hemat CPU menggunakan Windows API
        Sleep(1000);
        
        // Demonstrasi pemicu alarm otomatis: pada detik ke-15 program akan otomatis menjadwalkan alarm ke menit selanjutnya!
        jika (sec == 15) maka {
            alarm_jam = hr;
            alarm_menit = min + 1;
            jika (alarm_menit >= 60) maka {
                alarm_menit = 0;
                alarm_jam = alarm_jam + 1;
            }
            pengingat = "Waktunya coding TelaCore Nusantara!";
            alarm_aktif = benar;
        }
        
        jika (sec == 35) maka {
            PlaySoundA("SystemNotification", 0, 1);
        }
        
        jika (hr >= 24) maka {
            loop_run = 0;
        }
    }
}

fungsi utama() {
    main_clock_loop();
}
